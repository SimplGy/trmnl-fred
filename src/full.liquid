{% assign n = charts.size %}
{% if n == 0 %}
{% render "fred_empty", fred_ids: fred_ids, error: error %}
{% elsif n == 1 %}
<div class="layout layout--col gap--small">
  {% render "chart_cell", cell_chart: charts[0], fred_labels: fred_labels, label_h: 20, max_ticks: 12, title_class: "label" %}
</div>
{% elsif n == 2 %}
<div class="layout layout--col gap--small">
  {% render "chart_cell", cell_chart: charts[0], fred_labels: fred_labels, label_h: 18, max_ticks: 12 %}
  {% render "chart_cell", cell_chart: charts[1], fred_labels: fred_labels, label_h: 18, max_ticks: 12 %}
</div>
{% elsif n == 3 %}
<div class="layout layout--col gap--small">
  {% render "chart_cell", cell_chart: charts[0], fred_labels: fred_labels, label_h: 18, max_ticks: 12 %}
  <div class="flex flex--row gap--small w--full grow">
    {% render "chart_cell", cell_chart: charts[1], fred_labels: fred_labels, label_h: 18, max_ticks: 8 %}
    {% render "chart_cell", cell_chart: charts[2], fred_labels: fred_labels, label_h: 18, max_ticks: 8 %}
  </div>
</div>
{% else %}
<div class="layout layout--col gap--small">
  <div class="flex flex--row gap--small w--full grow">
    {% render "chart_cell", cell_chart: charts[0], fred_labels: fred_labels, label_h: 18, max_ticks: 8 %}
    {% render "chart_cell", cell_chart: charts[1], fred_labels: fred_labels, label_h: 18, max_ticks: 8 %}
  </div>
  <div class="flex flex--row gap--small w--full grow">
    {% render "chart_cell", cell_chart: charts[2], fred_labels: fred_labels, label_h: 18, max_ticks: 8 %}
    {% render "chart_cell", cell_chart: charts[3], fred_labels: fred_labels, label_h: 18, max_ticks: 8 %}
  </div>
</div>
{% endif %}

{% render "fred_title_bar", trmnl: trmnl %}
