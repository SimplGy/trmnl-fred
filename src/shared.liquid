{% comment %} optional short names: label_1, label_2, label_3, label_4 {% endcomment %}
{% assign cfv = trmnl.plugin_settings.custom_fields_values %}
{% assign lab_1 = cfv.label_1 %}
{% assign lab_2 = cfv.label_2 %}
{% assign lab_3 = cfv.label_3 %}
{% assign lab_4 = cfv.label_4 %}

{% assign fred_ids = "" %}
{% for i in (1..4) %}
{% assign sk = "series_" | append: i %}
{% assign sid = cfv[sk] %}
{% if sid and sid != "" %}
{% if fred_ids == "" %}{% assign fred_ids = sid %}{% else %}{% assign fred_ids = fred_ids | append: ", " | append: sid %}{% endif %}
{% endif %}
{% endfor %}

{% comment %} series id | short name pairs, used to look a label up by id {% endcomment %}
{% assign fred_labels = "" %}
{% if cfv.series_1 and lab_1 and lab_1 != "" %}{% assign fred_labels = fred_labels | append: cfv.series_1 | append: "|" | append: lab_1 | append: ";" %}{% endif %}
{% if cfv.series_2 and lab_2 and lab_2 != "" %}{% assign fred_labels = fred_labels | append: cfv.series_2 | append: "|" | append: lab_2 | append: ";" %}{% endif %}
{% if cfv.series_3 and lab_3 and lab_3 != "" %}{% assign fred_labels = fred_labels | append: cfv.series_3 | append: "|" | append: lab_3 | append: ";" %}{% endif %}
{% if cfv.series_4 and lab_4 and lab_4 != "" %}{% assign fred_labels = fred_labels | append: cfv.series_4 | append: "|" | append: lab_4 | append: ";" %}{% endif %}

{% template chart_cell %}
{% assign title_class = title_class | default: 'label label--small lg:label--large' %}
{% assign label_h = label_h | default: 18 %}
{% assign max_ticks = max_ticks | default: 6 %}

{% if cell_chart.error %}
<div class="flex flex--col flex--center gap--none w--full grow">
  <span class="label" data-clamp="1">No FRED data for {{ cell_chart.id }}</span>
</div>
{% else %}

{% comment %} short name override, matched by series id; falls back to the FRED title {% endcomment %}
{% assign cell_title = cell_chart.title %}
{% if fred_labels and fred_labels != "" %}
{% assign cid = cell_chart.id | upcase %}
{% assign pairs = fred_labels | split: ";" %}
{% for pr in pairs %}
{% assign kv = pr | split: "|" %}
{% assign kid = kv[0] | upcase %}
{% if kid == cid %}{% assign cell_title = kv[1] %}{% endif %}
{% endfor %}
{% endif %}

{% assign pts = cell_chart.points %}
{% assign span = pts.size | minus: 1 %}
{% assign lo = cell_chart.min | times: 1.0 %}
{% assign hi = cell_chart.max | times: 1.0 %}
{% assign range = hi | minus: lo %}
{% assign flat = false %}
{% if range <= 0 %}{% assign flat = true %}{% endif %}

{% comment %} median of the whole series; fall back to the range midpoint {% endcomment %}
{% assign med = cell_chart.median %}
{% if med == nil %}{% assign med = hi | plus: lo | divided_by: 2.0 %}{% endif %}
{% assign med = med | times: 1.0 %}

{% assign ydec = 0 %}
{% if range < 10 %}{% assign ydec = 1 %}{% endif %}

{% comment %} data is mapped into 20..280 of the 0..300 plot space, so the top
   and bottom labels have room to sit inside the plot rather than clip {% endcomment %}
{% if flat %}
{% assign y_med_pos = 150 %}
{% else %}
{% assign med_frac = med | minus: lo | divided_by: range %}
{% assign y_med_pos = 1.0 | minus: med_frac | times: 260.0 | plus: 20.0 | round %}
{% endif %}
{% assign y_med_pct = y_med_pos | plus: 4 | times: 100.0 | divided_by: 308.0 | round: 1 %}

{% assign pf = pts | first %}
{% assign pl = pts | last %}
{% assign yr_first = pf[0] | round | divided_by: 1000 | plus: 43200 | date: "%Y" | plus: 0 %}
{% assign yr_last = pl[0] | round | divided_by: 1000 | plus: 43200 | date: "%Y" | plus: 0 %}
{% assign dur = yr_last | minus: yr_first %}
{% assign tick_step = 1 %}
{% assign est = dur | plus: 1 %}
{% if est > max_ticks %}{% assign tick_step = 2 %}{% assign est = dur | divided_by: 2 | plus: 1 %}{% endif %}
{% if est > max_ticks %}{% assign tick_step = 5 %}{% assign est = dur | divided_by: 5 | plus: 1 %}{% endif %}
{% if est > max_ticks %}{% assign tick_step = 10 %}{% assign est = dur | divided_by: 10 | plus: 1 %}{% endif %}
{% if est > max_ticks %}{% assign tick_step = 20 %}{% assign est = dur | divided_by: 20 | plus: 1 %}{% endif %}

{% assign poly = "" %}
{% if span > 0 %}
{% for p in pts %}
{% assign x = forloop.index0 | times: 1000.0 | divided_by: span | round %}
{% if flat %}
{% assign y = 150 %}
{% else %}
{% assign frac = p[1] | minus: lo | divided_by: range %}
{% assign y = 1.0 | minus: frac | times: 260.0 | plus: 20.0 | round %}
{% endif %}
{% assign poly = poly | append: x | append: ',' | append: y | append: ' ' %}
{% endfor %}
{% endif %}

<div class="flex flex--col gap--none w--full grow">
  <span class="{{ title_class }}" data-clamp="1">{{ cell_title }}</span>
  <div class="flex flex--col gap--none w--full grow">
    <div class="flex flex--row gap--small w--full grow">
      <div class="no-shrink w--[32px]">
        <svg class="w--full h--full" aria-hidden="true">
          <text x="100%" y="7.8%" dominant-baseline="middle" text-anchor="end" fill="currentColor" font-size="12">{{ hi | round: ydec }}</text>
          <text x="100%" y="{{ y_med_pct }}%" dominant-baseline="middle" text-anchor="end" fill="currentColor" font-size="12">{{ med | round: ydec }}</text>
          <text x="100%" y="92.2%" dominant-baseline="middle" text-anchor="end" fill="currentColor" font-size="12">{{ lo | round: ydec }}</text>
        </svg>
      </div>
      <div class="grow">
        <svg class="w--full h--full" viewBox="-4 -4 1008 308" preserveAspectRatio="none" aria-hidden="true">
          <line x1="0" y1="-4" x2="0" y2="304" stroke="currentColor" stroke-width="2" vector-effect="non-scaling-stroke" />
          <line x1="0" y1="20" x2="26" y2="20" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke" />
          <line x1="0" y1="{{ y_med_pos }}" x2="26" y2="{{ y_med_pos }}" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke" />
          <line x1="0" y1="280" x2="26" y2="280" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke" />
          {% if span > 0 %}
          {% assign last_tick = -1 %}
          {% for p in pts %}
          {% assign yr = p[0] | round | divided_by: 1000 | plus: 43200 | date: "%Y" | plus: 0 %}
          {% assign rem = yr | modulo: tick_step %}
          {% if rem == 0 and yr != last_tick %}
          {% assign tx = forloop.index0 | times: 1000.0 | divided_by: span | round %}
          <line x1="{{ tx }}" y1="-4" x2="{{ tx }}" y2="304" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke" />
          {% assign last_tick = yr %}
          {% endif %}
          {% endfor %}
          {% endif %}
          <polyline points="{{ poly }}" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke" />
        </svg>
      </div>
    </div>
    <svg class="w--full h--[{{ label_h }}px] no-shrink" width="100%" height="{{ label_h }}" aria-hidden="true">
      {% if span > 0 %}
      {% assign last_tick = -1 %}
      {% for p in pts %}
      {% assign yr = p[0] | round | divided_by: 1000 | plus: 43200 | date: "%Y" | plus: 0 %}
      {% assign xp = forloop.index0 | times: 100.0 | divided_by: span | round %}
      {% assign rem = yr | modulo: tick_step %}
      {% if rem == 0 and yr != last_tick %}
      {% assign anchor = "middle" %}
      {% if xp < 8 %}{% assign anchor = "start" %}{% elsif xp > 92 %}{% assign anchor = "end" %}{% endif %}
      <text x="{{ xp }}%" y="{{ label_h | minus: 4 }}" text-anchor="{{ anchor }}" fill="currentColor" font-size="{{ label_h | minus: 3 }}">{{ yr }}</text>
      {% assign last_tick = yr %}
      {% endif %}
      {% endfor %}
      {% endif %}
    </svg>
  </div>
</div>

{% endif %}
{% endtemplate %}

{% template fred_title_bar %}
{% capture fred_icon %}<svg width="24" height="24" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 20.5V3.5" /><path d="M3.5 20.5H21" /><path d="M6.5 16.5l3.5-4.5 3.5 2.5 5-6.5" /></svg>{% endcapture %}
<div class="title_bar">
  <img class="image image-stroke" src="data:image/svg+xml;base64,{{ fred_icon | base64_encode }}" alt="">
  <span class="title">{{ trmnl.plugin_settings.instance_name }}</span>
  <span class="instance">made with <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="9" width="16" height="11" rx="2.5"/><path d="M12 5.5V9"/><circle cx="12" cy="4" r="1.5" fill="currentColor" stroke="none"/><circle cx="9.5" cy="14.5" r="1.3" fill="currentColor" stroke="none"/><circle cx="14.5" cy="14.5" r="1.3" fill="currentColor" stroke="none"/></svg> simple.gy</span>
</div>
{% endtemplate %}

{% template fred_empty %}
<div class="layout layout--col layout--center gap--small h--full">
  <span class="title" data-clamp="2">No FRED data for {{ fred_ids }}</span>
  <span class="description" data-clamp="2">{{ error }}</span>
</div>
{% endtemplate %}
