{% assign n = charts.size %}
{% if n == 0 %}
{% render "fred_empty", fred_ids: fred_ids, error: error %}
{% else %}
<div class="layout layout--col gap--small">
  <div class="flex flex--row gap--small w--full grow">
    {% if n == 1 %}
    {% render "chart_cell", cell_chart: charts[0], fred_labels: fred_labels, label_h: 18, max_ticks: 12, title_class: "label" %}
    {% elsif n == 2 %}
    {% render "chart_cell", cell_chart: charts[0], fred_labels: fred_labels, label_h: 18, max_ticks: 6 %}
    {% render "chart_cell", cell_chart: charts[1], fred_labels: fred_labels, label_h: 18, max_ticks: 6 %}
    {% elsif n == 3 %}
    {% render "chart_cell", cell_chart: charts[0], fred_labels: fred_labels, label_h: 18, max_ticks: 4 %}
    {% render "chart_cell", cell_chart: charts[1], fred_labels: fred_labels, label_h: 18, max_ticks: 4 %}
    {% render "chart_cell", cell_chart: charts[2], fred_labels: fred_labels, label_h: 18, max_ticks: 4 %}
    {% else %}
    {% render "chart_cell", cell_chart: charts[0], fred_labels: fred_labels, label_h: 18, max_ticks: 3 %}
    {% render "chart_cell", cell_chart: charts[1], fred_labels: fred_labels, label_h: 18, max_ticks: 3 %}
    {% render "chart_cell", cell_chart: charts[2], fred_labels: fred_labels, label_h: 18, max_ticks: 3 %}
    {% render "chart_cell", cell_chart: charts[3], fred_labels: fred_labels, label_h: 18, max_ticks: 3 %}
    {% endif %}
  </div>
</div>
{% endif %}

{% render "fred_title_bar", trmnl: trmnl %}
